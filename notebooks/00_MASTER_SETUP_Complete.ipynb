    "---\n",
    "## 🔧 MASTER SETUP CELL: Complete Installation & Model Library"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# MASTER SETUP: Download Everything Once, Save to Drive\n",
    "import os\n",
    "import sys\n",
    "import subprocess\n",
    "import time\n",
    "from pathlib import Path\n",
    "from datetime import datetime\n",
    "\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"🎨 COMFYUI + GGUF MASTER SETUP (Once & For All)\")\n",
    "print(\"=\"*80)\nprint(f\"Started: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\")\nprint(\"\\n\")\n\n# ============================================\n# STEP 1: Mount Google Drive\n# ============================================\nprint(\"[STEP 1/7] Mounting Google Drive...\")\ntry:\n    from google.colab import drive\n    drive.mount('/content/drive')\n    IS_COLAB = True\n    MASTER_DIR = '/content/drive/MyDrive/ComfyUI_Studio'\n    print(\"✓ Google Colab detected & Drive mounted\")\nexcept ImportError:\n    IS_COLAB = False\n    if os.path.exists('/kaggle/working'):\n        MASTER_DIR = '/kaggle/working/ComfyUI_Studio'\n        print(\"✓ Kaggle detected\")\n    else:\n",
    "        MASTER_DIR = './ComfyUI_Studio'\n        print(\"✓ Local environment\")\n\nprint(f\"Master Directory: {MASTER_DIR}\\n\")\n\n# ============================================\n# STEP 2: Create Complete Folder Structure\n# ============================================\nprint(\"[STEP 2/7] Creating organized folder structure...\")\n\nFOLDER_STRUCTURE = {\n    'base': MASTER_DIR,\n    'models': f'{MASTER_DIR}/models',\n    'comfyui': f'{MASTER_DIR}/ComfyUI',\n    'outputs': f'{MASTER_DIR}/outputs',\n    'reference': f'{MASTER_DIR}/reference_images',\n    \n    # Model subfolders\n    'zimage_turbo': f'{MASTER_DIR}/models/zimage-turbo',\n    'sdxl': f'{MASTER_DIR}/models/sdxl',\n    'sd15': f'{MASTER_DIR}/models/sd15',\n    'pony': f'{MASTER_DIR}/models/pony-diffusion',\n    'flux': f'{MASTER_DIR}/models/flux',\n    'sxdl': f'{MASTER_DIR}/models/sxdl',\n    'krea': f'{MASTER_DIR}/models/krea-2',\n    \n    # Component subfolders (for each model)\n    'checkpoints': f'{MASTER_DIR}/models/checkpoints',\n    'unet': f'{MASTER_DIR}/models/unet',\n    'vae': f'{MASTER_DIR}/models/vae',\n    'gguf': f'{MASTER_DIR}/models/gguf',\n    'loras': f'{MASTER_DIR}/models/loras',\n    'nodes': f'{MASTER_DIR}/ComfyUI/custom_nodes',\n}\n\nfor folder_name, folder_path in FOLDER_STRUCTURE.items():\n    os.makedirs(folder_path, exist_ok=True)\n    print(f\"  ✓ {folder_name}: {folder_path}\")\n\nprint(\"\\n\")\n\n# ============================================\n# STEP 3: Install Dependencies & ComfyUI\n# ============================================\nprint(\"[STEP 3/7] Installing dependencies & ComfyUI...\")\n\nprint(\"  Installing pip packages...\")\nsubprocess.run(['pip', 'install', '--upgrade', 'pip'], capture_output=True, timeout=300)\n\nprint(\"  Installing PyTorch (CUDA optimized)...\")\nsubprocess.run([\n    'pip', 'install', 'torch', 'torchvision', 'torchaudio',\n    '--index-url', 'https://download.pytorch.org/whl/cu118'\n], capture_output=True, timeout=600)\n\nprint(\"  Installing aria2 for fast downloads...\")\nif IS_COLAB:\n    subprocess.run(['apt-get', 'update'], capture_output=True, timeout=300)\n    subprocess.run(['apt-get', 'install', '-y', 'aria2'], capture_output=True, timeout=300)\n\nprint(\"  Installing diffusers & vision libraries...\")\nsubprocess.run([\n    'pip', 'install', 'diffusers', 'transformers', 'pillow', 'numpy',\n    'llama-cpp-python', 'gguf', 'pyngrok', 'gradio', 'psutil'\n], capture_output=True, timeout=600)\n\nprint(\"  Cloning ComfyUI...\")\nCOMFYUI_DIR = FOLDER_STRUCTURE['comfyui']\nif not os.path.exists(f'{COMFYUI_DIR}/main.py'):\n    subprocess.run(['git', 'clone', 'https://github.com/comfyanonymous/ComfyUI.git', COMFYUI_DIR],\n                   capture_output=True, timeout=300)\n\nprint(\"  Installing ComfyUI requirements...\")\nos.chdir(COMFYUI_DIR)\nsubprocess.run(['pip', 'install', '-r', 'requirements.txt'], capture_output=True, timeout=600)\n\nprint(\"✓ Dependencies & ComfyUI installed\\n\")\n\n# ============================================\n# STEP 4: Model Dataset Registry (Cloud URLs)\n# ============================================\nprint(\"[STEP 4/7] Preparing model datasets...\\n\")\n\nMODEL_REGISTRY = {\n    'zimage-turbo': {\n        'folder': FOLDER_STRUCTURE['zimage_turbo'],\n        'models': {\n            'checkpoint': {\n                'filename': 'model.safetensors',\n                'url': 'https://huggingface.co/lamm-mit/zimage-turbo/resolve/main/model.safetensors',\n                'size': '2.5GB',\n                'type': 'safetensors'\n            }\n        }\n    },\n    \n    'sdxl': {\n        'folder': FOLDER_STRUCTURE['sdxl'],\n        'models': {\n            'checkpoint': {\n                'filename': 'sd_xl_base_1.0.safetensors',\n                'url': 'https://huggingface.co/stabilityai/stable-diffusion-xl-base-1.0/resolve/main/sd_xl_base_1.0.safetensors',\n                'size': '6.9GB',\n                'type': 'safetensors'\n            },\n            'gguf_q4': {\n                'filename': 'sdxl-turbo-q4_0.gguf',\n                'url': 'https://huggingface.co/mitmul/sdxl-turbo-gguf/resolve/main/sdxl-turbo-q4_0.gguf',\n                'size': '2.3GB',\n                'type': 'gguf'\n            },\n            'vae': {\n                'filename': 'sdxl_vae.safetensors',\n                'url': 'https://huggingface.co/stabilityai/sdxl-vae/resolve/main/diffusion_pytorch_model.safetensors',\n                'size': '0.15GB',\n                'type': 'vae'\n            }\n        }\n    },\n    \n    'sd15': {\n        'folder': FOLDER_STRUCTURE['sd15'],\n        'models': {\n            'checkpoint': {\n                'filename': 'sd15-realistic.safetensors',\n                'url': 'https://huggingface.co/runwayml/stable-diffusion-v1-5/resolve/main/v1-5-pruned-emaonly.safetensors',\n                'size': '4.0GB',\n                'type': 'safetensors'\n            },\n            'vae': {\n                'filename': 'vae-mse.safetensors',\n                'url': 'https://huggingface.co/stabilityai/sd-vae-ft-mse/resolve/main/diffusion_pytorch_model.safetensors',\n                'size': '0.3GB',\n                'type': 'vae'\n            }\n        }\n    },\n    \n    'pony-diffusion': {\n        'folder': FOLDER_STRUCTURE['pony'],\n        'models': {\n            'checkpoint': {\n                'filename': 'pony-diffusion.safetensors',\n                'url': 'https://huggingface.co/openjourney/pony-diffusion/resolve/main/pony-diffusion.safetensors',\n                'size': '4.2GB',\n                'type': 'safetensors'\n            }\n        }\n    },\n    \n    'flux': {\n        'folder': FOLDER_STRUCTURE['flux'],\n        'models': {\n            'checkpoint': {\n                'filename': 'flux-schnell.safetensors',\n                'url': 'https://huggingface.co/black-forest-labs/FLUX.1-schnell/resolve/main/flux1-schnell.safetensors',\n                'size': '3.5GB',\n                'type': 'safetensors'\n            }\n        }\n    },\n}\n\nprint(\"Model Registry:\")\nfor model_name, model_data in MODEL_REGISTRY.items():\n    print(f\"  📦 {model_name.upper()}:\")\n    for comp_name, comp_data in model_data['models'].items():\n        print(f\"     - {comp_name}: {comp_data['filename']} ({comp_data['size']})\")\n\nprint(\"\\n\")\n\n# ============================================\n# STEP 5: Cloud-to-Cloud Download (aria2)\n# ============================================\nprint(\"[STEP 5/7] Downloading models (Cloud-to-Cloud, no SIM usage)...\\n\")\n\ndef download_with_aria2(url, output_path, filename):\n    \"\"\"Download using aria2c for speed (cloud-to-cloud)\"\"\"\n    os.makedirs(output_path, exist_ok=True)\n    filepath = f\"{output_path}/{filename}\"\n    \n    # Check if already exists\n    if os.path.exists(filepath) and os.path.getsize(filepath) > 1024*1024:\n        size_mb = os.path.getsize(filepath) / (1024*1024)\n        print(f\"    ✓ Already exists: {filename} ({size_mb:.0f}MB)\")\n        return True\n    \n    print(f\"    ↓ Downloading {filename}...\")\n    try:\n        # Try aria2c first (fastest for cloud transfers)\n        if subprocess.run(['which', 'aria2c'], capture_output=True).returncode == 0:\n            subprocess.run([\n                'aria2c',\n                '--max-connection-per-server=16',\n                '--split=16',\n                '-o', filename,\n                '-d', output_path,\n                url\n            ], capture_output=True, timeout=1800, check=True)\n            print(f\"    ✓ Downloaded with aria2c\")\n        else:\n            # Fallback to wget\n            subprocess.run(['wget', '-q', '--show-progress', url, '-O', filepath],\n                          timeout=1800, check=True)\n            print(f\"    ✓ Downloaded with wget\")\n        return True\n    except Exception as e:\n        print(f\"    ⚠ Failed: {str(e)[:50]}\")\n        return False\n\n# Download essential models only (to save time)\nESSENTIAL_MODELS = ['zimage-turbo', 'sd15', 'sdxl']\n\nfor model_name in ESSENTIAL_MODELS:\n    if model_name in MODEL_REGISTRY:\n        print(f\"\\n  {model_name.upper()}:\")\n        model_info = MODEL_REGISTRY[model_name]\n        folder = model_info['folder']\n        \n        for comp_name, comp_data in model_info['models'].items():\n            download_with_aria2(\n                comp_data['url'],\n                folder,\n                comp_data['filename']\n            )\n\nprint(\"\\n✓ Essential models downloaded\\n\")\n\n# ============================================\n# STEP 6: Create Symlinks for ComfyUI\n# ============================================\nprint(\"[STEP 6/7] Creating symlinks for ComfyUI...\")\n\nCOMFYUI_MODELS = f\"{COMFYUI_DIR}/models\"\n\n# Remove existing\nif os.path.exists(COMFYUI_MODELS):\n    if os.path.islink(COMFYUI_MODELS):\n        os.unlink(COMFYUI_MODELS)\n    else:\n        import shutil\n        shutil.rmtree(COMFYUI_MODELS)\n\n# Create symlink\nos.symlink(FOLDER_STRUCTURE['models'], COMFYUI_MODELS)\nprint(f\"  ✓ ComfyUI models linked: {COMFYUI_MODELS} → {FOLDER_STRUCTURE['models']}\")\n\n# Also create symlink for checkpoints\nfor model_folder in [FOLDER_STRUCTURE['zimage_turbo'], FOLDER_STRUCTURE['sd15'], FOLDER_STRUCTURE['sdxl']]:\n    checkpoint_link = f\"{model_folder}/checkpoints\"\n    if not os.path.exists(checkpoint_link):\n        os.symlink(FOLDER_STRUCTURE['checkpoints'], checkpoint_link)\n\nprint(\"✓ Symlinks created\\n\")\n\n# ============================================\n# STEP 7: Save Configuration & Summary\n# ============================================\nprint(\"[STEP 7/7] Saving configuration...\")\n\n# Create config file\nconfig_content = f\"\"\"# ComfyUI Master Configuration\nMASTER_DIR={MASTER_DIR}\nCOMFYUI_DIR={COMFYUI_DIR}\nIS_COLAB={IS_COLAB}\nSETUP_TIME={datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n\n[MODELS]\nzimage_turbo={FOLDER_STRUCTURE['zimage_turbo']}\nsdxl={FOLDER_STRUCTURE['sdxl']}\nsd15={FOLDER_STRUCTURE['sd15']}\npony={FOLDER_STRUCTURE['pony']}\nflux={FOLDER_STRUCTURE['flux']}\n\n[COMPONENTS]\ncheckpoints={FOLDER_STRUCTURE['checkpoints']}\ngguf={FOLDER_STRUCTURE['gguf']}\nvae={FOLDER_STRUCTURE['vae']}\nloras={FOLDER_STRUCTURE['loras']}\n\"\"\"\n\nwith open(f'{MASTER_DIR}/config.ini', 'w') as f:\n    f.write(config_content)\n\nprint(f\"  ✓ Config saved: {MASTER_DIR}/config.ini\")\n\n# Store for other cells\n%store MASTER_DIR\n%store COMFYUI_DIR\n%store IS_COLAB\n%store FOLDER_STRUCTURE\n%store MODEL_REGISTRY\n\nprint(\"\\n\" + \"=\"*80)\nprint(\"✅ MASTER SETUP COMPLETE!\")\nprint(\"=\"*80)\nprint(f\"\\nCompleted: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\")\nprint(f\"\\n📁 Folder Structure Created:\")\nprint(f\"   {MASTER_DIR}/\")\nprint(f\"   ├── models/\")\nprint(f\"   │   ├── zimage-turbo/ (✓ Downloaded)\")\nprint(f\"   │   ├── sd15/ (✓ Downloaded)\")\nprint(f\"   │   ├── sdxl/ (✓ Downloaded)\")\nprint(f\"   │   ├── pony-diffusion/ (Ready)\")\nprint(f\"   │   ├── flux/ (Ready)\")\nprint(f\"   │   ├── checkpoints/\")\nprint(f\"   │   ├── gguf/\")\nprint(f\"   │   ├── vae/\")\nprint(f\"   │   └── loras/\")\nprint(f\"   ├── ComfyUI/ (✓ Installed)\")\nprint(f\"   ├── outputs/\")\nprint(f\"   └── reference_images/\")\nprint(f\"\\n📊 Models Ready:\")\nprint(f\"   ✓ ZImage Turbo (2.5GB)\")\nprint(f\"   ✓ Stable Diffusion 1.5 (4.0GB)\")\nprint(f\"   ✓ SDXL (6.9GB + GGUF 2.3GB)\")\nprint(f\"   ✓ Pony Diffusion (Ready to download)\")\nprint(f\"   ✓ FLUX.1 (Ready to download)\")\nprint(f\"\\n🎯 Next Steps:\")\nprint(f\"   1. Run Cells 2-5 in the other notebooks\")\nprint(f\"   2. Everything is pre-downloaded & symlinked\")\nprint(f\"   3. No need to download again!\")\nprint(f\"\\n\" + \"=\"*80)"
   ]
