    "        print(f\"{subindent}📄 {file} ({size_gb:.1f}GB)\")\n",
    "\nprint(\"\\n✓ ComfyUI Installation:\")\ncomfyui_files = os.listdir(FOLDER_STRUCTURE['comfyui'])\nif 'main.py' in comfyui_files:\n",
    "    print(f\"  ✓ ComfyUI installed ({len(comfyui_files)} files)\")\nelse:\n",
    "    print(f\"  ⚠ ComfyUI may need reinstall\")\n\nprint(\"\\n\" + \"=\"*70)\nprint(\"✅ Setup verified! Ready to use.\")\nprint(\"=\"*70)"
