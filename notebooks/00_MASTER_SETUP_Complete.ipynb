    "%store -r FOLDER_STRUCTURE\n",
    "%store -r MASTER_DIR\n",
    "\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"SETUP VERIFICATION\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "print(\"\\n✓ Folder Structure:\")\nfor folder_name, folder_path in FOLDER_STRUCTURE.items():\n",
    "    exists = \"✓\" if os.path.exists(folder_path) else \"✗\"\n",
    "    try:\n",
    "        files = len(os.listdir(folder_path))\n",
    "        print(f\"  {exists} {folder_name:20} - {files:3} files\")\n",
    "    except:\n",
    "        print(f\"  {exists} {folder_name:20} - (empty)\")\n",
    "\nprint(\"\\n✓ Downloaded Models:\")\nfor root, dirs, files in os.walk(f\"{MASTER_DIR}/models\"):\n",
    "    level = root.replace(f\"{MASTER_DIR}/models\", '').count(os.sep)\n",
